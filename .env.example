# ---------------------------------------------------------------------------
# Supabase (Postgres)
# ---------------------------------------------------------------------------
# Project URL + anon key are used by the browser-safe client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key is used by server-side route handlers so that the commute
# cache can be written. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by `npm run db:migrate` and
# `npm run db:seed`. Found under Project Settings -> Database -> Connection string.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Geocoding + routing
# ---------------------------------------------------------------------------
# All of the below are OPTIONAL. With none of them set the app falls back to
# keyless OpenStreetMap services (Nominatim for geocoding, OSRM for routing),
# which is enough to run every demo scenario.
#
# Nominatim's usage policy requires a contact address in the User-Agent header.
GEO_CONTACT_EMAIL=

# If set, Google is used as the primary geocoder + travel time provider and the
# OSM services become the fallback.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Research pipeline (offline)
# ---------------------------------------------------------------------------
# Only needed to re-run `npm run research:extract`, which turns saved venue
# pages into structured rooms/capacities. The app itself never calls an LLM.
ANTHROPIC_API_KEY=
